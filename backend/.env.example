# Kavach Node BFF — local development configuration.
# Copy to backend/.env and adjust. backend/.env is git-ignored.

# Port the Node BFF listens on (browser-facing).
PORT=3001

# Unified Python backend (api.main) that Node proxies to.
PYTHON_API_URL=http://localhost:8000

# Shared API key. MUST match the API_KEY env var of the Python process,
# because Node validates x-api-key and forwards it upstream (artifact routes
# require it). Never commit a real key.
API_KEY=local-dev-key

# Browser origin allowed by CORS (the Vite dev server).
FRONTEND_URL=http://localhost:5173

# Per-request upstream timeout in milliseconds (prevents indefinite hangs).
UPSTREAM_TIMEOUT_MS=15000
